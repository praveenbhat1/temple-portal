# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what every deployment needs and
# holds no values. Without it a fresh clone has no way to know that a missing
# TEMPLE_UPI_ID is what took bookings offline.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scratch scripts. These are throwaway files that tend to accumulate
# hardcoded credentials — scratch/test_razorpay.js held a live Razorpay
# key_secret in plain text. Keep the whole directory out of the repository.
scratch/

# Editor workspace files are personal, not project configuration.
*.code-workspace
