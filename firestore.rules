rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin check ────────────────────────────────────────────────────────
    // An admin is a signed-in user whose email has a document in /admins,
    // keyed BY THAT EMAIL (e.g. /admins/priest@example.com).
    //
    // The doc id must be the email, because that is the only shape a security
    // rule can look up directly. lib/firestore.ts reads it the same way, so the
    // client UI and these rules can never disagree.
    //
    // email_verified is deliberately NOT required. Temple admins are created by
    // hand in the Firebase console with a password, and console-created accounts
    // are unverified — requiring it locked every one of them out of every write
    // while the UI still showed them as signed in. Membership of /admins is the
    // gate, and only the Firebase console can grant it (see the /admins rules).
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Fields a devotee's booking must never carry a client-side edit to.
    // Used to keep the admin UI honest even though the real writes go through
    // the Admin SDK, which bypasses these rules entirely.
    function unchanged(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    match /sevas/{document} {
      allow read: if true;
      allow write: if isAdmin();
      // Booking counters are incremented server-side by the Admin SDK, which
      // bypasses these rules, so no public update carve-out is needed.
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{document=**} {
      // Bookings are created ONLY by the server:
      //   • /api/bookings/create  — manual UPI flow, written as `pending`
      //   • /api/razorpay/verify  — after a gateway signature has been verified
      // The Admin SDK bypasses these rules, so denying every client write here
      // is what stops a visitor from forging a paid booking.
      allow create: if false;
      allow delete: if false;

      // An admin may annotate a booking from the dashboard (internal notes,
      // and nothing else). Money-bearing fields stay server-owned: settling a
      // payment goes through /api/bookings/confirm so it is transactional and
      // attributable, never a raw client write.
      allow update: if isAdmin() &&
                    unchanged('paymentStatus') &&
                    unchanged('totalAmount') &&
                    unchanged('sevas') &&
                    unchanged('bookingId') &&
                    unchanged('confirmedBy') &&
                    unchanged('phone');

      // Devotees look their booking up through /api/bookings/lookup, which also
      // runs server-side. Direct client reads are admin-only.
      //
      // NOTE: the previous rule tried request.query.filters.phone — that field
      // does not exist in Firestore rules (only limit/offset/orderBy), so the
      // expression errored and every lookup silently returned nothing.
      allow read: if isAdmin();
    }

    match /admins/{email} {
      // A signed-in user may read ONLY their own admin record, which is all the
      // UI needs to decide whether to show the dashboard. The previous rule was
      // `allow read: if true`, which published the temple's full list of
      // administrator email addresses to anyone who opened the site.
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false; // Manage from the Firebase console only.
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcmTokens/{token} {
      // Written only by /api/fcm/subscribe via the Admin SDK. Keeping this shut
      // stops anyone from harvesting or spamming the subscriber list.
      allow read, write: if false;
    }

    // Anything not matched above is denied. Spelling it out means a collection
    // added later fails closed instead of inheriting someone's open rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
