rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone can view the gallery images
      allow read: if true;
      // Only the primary admin can upload or delete images
      allow write: if request.auth != null && 
                   request.auth.token.email == 'sowkurpraveenbhat@gmail.com';
    }
  }
}
