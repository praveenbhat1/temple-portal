# ══════════════════════════════════════════════════════════════════════════
#  Sunkadakatte Sri Vinayaka Temple — environment variables
#
#  Copy to .env.local and fill in. Anything marked REQUIRED must be set or
#  that part of the site is simply off; /admin shows a System Health panel
#  that names exactly what is missing, so you never have to guess.
#
#  NEXT_PUBLIC_* values are compiled into the browser bundle and are visible
#  to every visitor. Never put a secret behind that prefix.
# ══════════════════════════════════════════════════════════════════════════

# ── Firebase, browser side ────────────────────────────────── REQUIRED ──────
# Firebase Console → Project Settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase, server side ─────────────────────────────────── REQUIRED ──────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Paste the whole JSON, or its base64 (easier in Vercel, which
# mangles newlines). Without this: no bookings, no confirmations, no Track Seva.
FIREBASE_SERVICE_ACCOUNT=

# ── UPI payments ──────────────────────────────────────────── REQUIRED ──────
# The temple's UPI id (VPA) that devotees pay into, e.g. temple@okhdfcbank.
# Without this every booking attempt fails with a 503.
TEMPLE_UPI_ID=
# Name the devotee sees in their UPI app when the link opens.
TEMPLE_UPI_NAME=Sri Vinayaka Temple
# "upi"      — devotee pays by UPI/QR, an admin confirms it in /admin/bookings.
# "razorpay" — the card/netbanking gateway flow.
NEXT_PUBLIC_PAYMENT_MODE=upi

# ── Razorpay ───────────────────────────────────────── only for razorpay ────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Admin access ────────────────────────────────────────────────────────────
# There is no env var for this on purpose. An admin is a document in the
# Firestore `admins` collection whose ID is their email address:
#     admins/priest@example.com
# Create the account under Firebase Console → Authentication, then add that
# document. The security rules and the site UI both read the same collection,
# so there is exactly one place to grant or revoke access.

# ── Devotee messages: WhatsApp ─────────────────────────────── OPTIONAL ─────
# Leave blank and confirmations are still sent — an admin taps the WhatsApp
# button on the booking and the message is pre-typed. Free, no setup.
# Fill these in to have it happen automatically (Meta WhatsApp Cloud API).
#
# The template named below MUST exist and be APPROVED in WhatsApp Manager,
# with a body of exactly five variables in this order. Copy this body verbatim:
#
#     Namaskara {{1}},
#
#     Seva status: {{2}}
#     Booking Ref: {{3}}
#     Seva Date: {{4}}
#     Amount: Rs. {{5}}
#
#     Sri Vinayaka Temple, Kallianpur
#
# Category: UTILITY (not Marketing — utility is cheaper and approved faster).
# Do not use a body that is only a variable: Meta rejects those at review, and
# rejects parameters containing newlines at send time.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ── Devotee messages: SMS fallback ─────────────────────────── OPTIONAL ─────
# For devotees without WhatsApp. Either provider works; MSG91 is tried first.
# Both need DLT sender registration in India before they will deliver.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=

# ── Browser push notifications ─────────────────────────────── OPTIONAL ─────
# Firebase Console → Cloud Messaging → Web Push certificates → key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Miscellaneous ───────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_LINK=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
